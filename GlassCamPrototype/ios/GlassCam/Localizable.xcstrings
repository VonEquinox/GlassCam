    },
    "Each tap saves original camera frames and the glass decision. Records stay on this iPhone until you copy or export them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每按一次都会保存原始双摄画面和玻璃的判定数据。记录保存在本机，供之后复制或导出。"
          }
        }
      }
    },
    "Effect exposure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果曝光"
          }
        }
      }
