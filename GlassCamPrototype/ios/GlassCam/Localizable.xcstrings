          }
        }
      }
    },
    "F5 combines four main exposures and one short exposure. It uses the main camera’s native view and a 2× output grid. Detail can fall back locally when motion or highlights cannot be recovered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "F5 合成四帧主曝光和一帧短曝光，使用主摄原生视角，横纵各 2× 采样。运动或高光信息不足时，局部会退回原生细节。"
          }
        }
      }
    },
    "F5 main camera": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "F5 主摄"
          }
        }
      }
    },
    "F5 starts with the iPhone 18 Pro Max main camera. Telephoto and Ultra Wide will follow after main-camera validation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "F5 首先适配 iPhone 18 Pro Max 主摄；主摄完成验证后再适配长焦和超广角。"
          }
        }
      }
    },
