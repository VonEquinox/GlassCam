          "stringUnit": {
            "state": "translated",
            "value": "取景"
          }
        }
      }
    },
    "Viewfinder. Open camera controls": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取景。打开相机控制"
          }
        }
      }
    },
    "Viewfinder. Tap to focus; hold to lock focus and exposure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取景框。轻点对焦，长按锁定对焦和曝光"
          }
        }
      }
    },
    "Vivid Slide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鲜艳反转片"
          }
        }
      }
    },
    "Wait for the camera before adjusting focus.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待相机就绪后再调整对焦。"
          }
        }
      }
    },
    "Warm Cast": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暖调光感"
          }
        }
      }
    },
    "Warm Complexion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温润人像"
          }
        }
