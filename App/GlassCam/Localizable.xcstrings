{
  "sourceLanguage": "en",
  "strings": {
    "11 RAW samples saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "11 张 RAW 素材已保存。"
          }
        }
      }
    },
    "2× in each dimension": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横纵各 2× 采样"
          }
        }
      }
    },
    "2× sampling": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2× 采样"
          }
