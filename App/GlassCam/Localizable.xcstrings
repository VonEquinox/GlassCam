          }
        }
      }
    },
    "Use XH2S PROVIA or ACROS with default reference adjustments for live color. Showing system preview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选用 XH2S 的 PROVIA 或 ACROS，并保持默认参考调整以使用实时色彩。当前显示相机原画。"
          }
        }
      }
    },
    "Uses the original preset white balance, when specified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设指定白平衡时，使用其原始白平衡。"
          }
        }
      }
    },
    "Uses this look’s sharpening and grain settings, when available. Your choices stay saved when you change looks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前风格包含的锐化与颗粒参数，切换风格时会保留开关选择。"
          }
        }
      }
    },
