    },
    "Warm Tint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "怀旧暖褐"
          }
        }
      }
    },
    "When enabled, each Balanced photo also writes 32-bit float pre-color files to Files → GlassCam → RAWCaptures (~570 MB per photo).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，每张 Balanced 照片还会向“文件”→ GlassCam → RAWCaptures 写入 32 位浮点调色前原片（每张约 570 MB）。"
          }
        }
      }
    },
    "When enabled, saved F5 photos keep their RAW set in Files under F5Archives. Each set can use several hundred megabytes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，已保存照片的 RAW 原片会保留在“文件”的 F5Archives 文件夹，每组可能占用数百 MB。"
          }
        }
      }
    },
    "When enabled, saved photos keep their Bayer RAW input set in Files → GlassCam → F5Archives.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，已保存照片的 Bayer RAW 输入原片组会保留在“文件”→ GlassCam → F5Archives。"
          }
        }
      }
    },
