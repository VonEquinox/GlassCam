        }
      }
    },
    "Approx. preview · HDR": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近似预览 · HDR"
          }
        }
      }
    },
    "Approximate color only; the saved photo uses the complete selected effect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅近似显示色彩；保存照片使用完整的所选效果。"
          }
        }
      }
    },
    "As Shot (Standard fallback)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随拍摄（回退 Standard）"
          }
        }
      }
    },
    "As Shot uses the Standard film curve for iPhone photos. The selected preset also supplies its tone and detail settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 照片的 As Shot 使用 Standard 胶片曲线。所选预设同时提供明暗和细节设置。"
          }
        }
      }
    },
    "Automatic camera": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动相机"
          }
        }
      }
    },
    "Automatic lens selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动选择镜头"
          }
        }
