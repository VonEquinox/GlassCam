    "The RAW frames have inconsistent exposure settings. Fusion could not finish; the originals were kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RAW 帧的曝光设置不一致，无法完成合成；原片已保留。"
          }
        }
      }
    },
    "The clear central frame is your photo. The outer glass darkens when camera views cannot align reliably.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中央清晰区域就是成片范围。多摄画面无法可靠对齐时，外围玻璃会变黑。"
          }
        }
      }
    },
    "The current exposure is too short for F5. Try a scene with less light.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前曝光时间过短，无法完成 F5 拍摄。请尝试光线稍暗的场景。"
          }
        }
      }
    },
    "The main camera did not become ready for recording.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主摄未能准备好，无法开始记录。"
          }
        }
      }
    },
    "This native LUT asset is unavailable. Choose another look or family.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此原生 LUT 不可用，请选择其他风格或系列。"
          }
        }
      }
    },
    "To add sharpening or grain to FFCS looks, enable additional reference adjustments in Advanced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要为 FFCS 风格添加锐化或颗粒，请在高级设置中开启参考解析调整。"
          }
        }
      }
    },
    "Tone / Post exposure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调／后期曝光"
          }
        }
      }
    },
    "Tone and post-exposure gain": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调与后期曝光增益"
          }
        }
      }
    },
    "True Natural": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实自然"
          }
        }
      }
    },
    "True Neutral": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忠实还原"
          }
        }
      }
    },
    "Ultra Wide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超广角"
          }
        }
      }
    },
    "Unprocessed system camera preview inside the photograph frame": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成像框内为系统相机预览"
          }
        }
      }
    },
    "Uses the original preset white balance, when specified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设指定白平衡时，使用其原始白平衡。"
          }
        }
      }
    },
    "Uses this look’s sharpening and grain settings, when available. Your choices stay saved when you change looks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前风格包含的锐化与颗粒参数，切换风格时会保留开关选择。"
          }
        }
      }
    },
    "View latest saved photo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看最近保存的照片"
          }
        }
      }
    },
