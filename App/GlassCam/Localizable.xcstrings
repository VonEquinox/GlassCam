    "Also keep Bayer input frames": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保留 Bayer 输入原片"
          }
        }
      }
    },
    "Apply your saved settings and automatically save an HDR photo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已保存的设置，自动保存 HDR 照片"
