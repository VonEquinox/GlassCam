# Local development caches
__pycache__/
*.py[cod]
.DS_Store
.venv/
.pytest_cache/

# Prototype build and Xcode user state
/GlassCamPrototype/**/build/
/GlassCamPrototype/**/DerivedData/
/GlassCamPrototype/**/xcuserdata/
/GlassCamPrototype/**/*.xcuserstate

# Original FFCS assets are materialized from the pinned source archive
/GlassCamPrototype/ios/GlassCam/Resources/FFCS/*/
/GlassCamPrototype/ios/GlassCam/Resources/FFCS/.verified
/GlassCamPrototype/reference_ffcs/implementation/ffcs/data/**/*.lutz
/GlassCamPrototype/reference_ffcs/implementation/ffcs/data/**/*.icc
/GlassCamPrototype/reference_ffcs/examples/generated/

# Materialized from the checked, self-contained LUMIX archive at build time
/GlassCamPrototype/ios/GlassCam/Resources/LUMIX/

# Local photo inputs and exports
*.heic
*.heif
*.tif
*.tiff
*.dng
*.DNG
*.arw
*.ARW
*.3fr
*.3FR

# Diagnostic previews; application image assets remain trackable
/GlassCamPrototype/validation/**/*.png
/GlassCamPrototype/validation/**/*.jpg
/GlassCamPrototype/validation/**/*.jpeg
/GlassCamPrototype/validation/**/*.webp

# Local distributions and signing material
*.dmg
*.ipa
*.xcarchive/
*.mobileprovision
*.p12
