# Local development caches
__pycache__/
*.py[cod]
.DS_Store
.venv/
.pytest_cache/

# Build and Xcode user state
/build/
/**/build/
/**/DerivedData/
/**/xcuserdata/
/**/*.xcuserstate

# Original FFCS assets are materialized from the pinned source archive
/App/GlassCam/Resources/FFCS/*/
/App/GlassCam/Resources/FFCS/.verified
/vendor/ffcs/implementation/ffcs/data/**/*.lutz
/vendor/ffcs/implementation/ffcs/data/**/*.icc
/vendor/ffcs/examples/generated/

# Materialized from the checked, self-contained LUMIX archive at build time
/App/GlassCam/Resources/LUMIX/

# Local photo inputs and exports
*.heic
*.heif
*.tif
*.tiff
*.dng
*.DNG
*.arw
*.ARW
*.3fr
*.3FR

# Diagnostic previews; application image assets remain trackable
/validation/**/*.png
/validation/**/*.jpg
/validation/**/*.jpeg
/validation/**/*.webp

# Local distributions and signing material
*.dmg
*.ipa
*.xcarchive/
*.mobileprovision
*.p12

# Swift Package Manager products and local state
.build/
.swiftpm/
